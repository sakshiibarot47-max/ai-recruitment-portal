PORT=5000

# Login token ka secret. Lamba random text rakho (kam se kam 32 akshar). Kabhi git me mat daalo.
# Naya banane ke liye: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend ka address (comma se alag karke kai). Live site par apni site ka https address daalo.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# true = naya account OTP se verify karna zaroori. Live site par hamesha true.
REQUIRE_VERIFICATION=true

# --- Email OTP (Brevo / Resend / Gmail SMTP me se koi bhi). Khali = OTP sirf terminal me dikhega ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HireAI <no-reply@yourdomain.com>

# --- SMS OTP. Khali = OTP sirf terminal me dikhega ---
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
